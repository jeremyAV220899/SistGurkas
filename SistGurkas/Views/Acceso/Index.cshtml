@model SistGurkas.Models.Acceso.Usuario;
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <base href="/" />

    <title>Portal Gurkas</title>

    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1, shrink-to-fit=no" />

    <!-- FAVICON -->
    <link rel="shortcut icon" href="~/assets/media/gurkas/gurkas.ico" />

    <!-- FUENTE -->
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />

    <!-- METRONIC 8 -->
    <link href="~/assets/plugins/global/plugins.bundle.css"
          rel="stylesheet"
          type="text/css" />

    <link href="~/assets/css/style.bundle.css"
          rel="stylesheet"
          type="text/css" />

    <style>

        /* =========================================================
                   GENERAL
                ========================================================= */

        * {
            box-sizing: border-box;
        }

        html,
        body {
            width: 100%;
            min-width: 0;
            height: 100%;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }

        body {
            font-family: 'Inter', sans-serif;
            overflow-y: hidden;
        }


        /* =========================================================
                   FONDO
                ========================================================= */

        .gurkas-login-page {
            position: relative;
            width: 100%;
            min-width: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: flex-end;
            padding: 40px 6.5%;
            background-image: url('@Url.Content("~/assets/media/gurkas/fondo_gurkas.png")');
            background-size: cover;
            background-position: center center;
            background-repeat: no-repeat;
            overflow: hidden;
        }


        /* =========================================================
                   LOGIN WRAPPER
                ========================================================= */

        .login-wrapper {
            position: relative;
            z-index: 5;
            width: 100%;
            max-width: 500px;
            min-width: 0;
        }


        /* =========================================================
                   CARD
                ========================================================= */

        .gurkas-login-card {
            position: relative;
            z-index: 2;
            width: 100%;
            min-width: 0;
            padding: 48px 42px 42px;
            background: rgba(255, 255, 255, .98);
            border: 1px solid rgba(218, 223, 230, .90);
            border-radius: 16px;
            box-shadow: 0 25px 70px rgba(0, 0, 0, .20), 0 8px 25px rgba(0, 0, 0, .08);
            backdrop-filter: blur(4px);
        }


        /* =========================================================
                   CABECERA
                ========================================================= */

        .login-header {
            text-align: center;
            margin-bottom: 38px;
        }

        .login-title {
            margin: 0;
            font-size: 31px;
            line-height: 1.2;
            font-weight: 700;
            letter-spacing: -.6px;
            color: #111827;
        }

        .login-subtitle {
            margin-top: 10px;
            margin-bottom: 0;
            font-size: 15px;
            font-weight: 400;
            color: #6b7280;
        }


        /* =========================================================
                   CAMPOS
                ========================================================= */

        .login-field {
            width: 100%;
            min-width: 0;
            margin-bottom: 24px;
        }

        .login-label {
            display: block;
            margin-bottom: 9px;
            font-size: 14px;
            font-weight: 600;
            color: #151922;
        }


        /* =========================================================
                   PASSWORD HEADER
                ========================================================= */

        .password-header {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            margin-bottom: 9px;
        }

            .password-header .login-label {
                margin-bottom: 0;
            }


        /* =========================================================
                   INPUT
                ========================================================= */

        .gurkas-input {
            width: 100%;
            min-width: 0;
            height: 52px;
            display: flex;
            align-items: center;
            gap: 11px;
            padding-left: 16px;
            padding-right: 10px;
            border: 1px solid #d8dde5;
            border-radius: 7px;
            background: #ffffff;
            transition: border-color .2s ease, box-shadow .2s ease;
        }

            .gurkas-input:focus-within {
                border-color: #ef0018;
                box-shadow: 0 0 0 3px rgba(239, 0, 24, .08);
            }

            .gurkas-input .svg-icon {
                flex-shrink: 0;
                color: #8b96a8;
            }

                .gurkas-input .svg-icon svg {
                    width: 20px;
                    height: 20px;
                }

            .gurkas-input input {
                flex: 1;
                width: auto;
                min-width: 0;
                padding: 0;
                border: none;
                outline: none;
                background: transparent;
                color: #1f2937;
                font-family: 'Inter', sans-serif;
                font-size: 14px;
            }

                .gurkas-input input::placeholder {
                    color: #9ca3af;
                }


        /* =========================================================
                   PASSWORD TOGGLE
                ========================================================= */

        .password-toggle {
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            padding: 0;
            border: none;
            outline: none;
            cursor: pointer;
            background: transparent;
            border-radius: 6px;
            color: #919aaa;
            transition: background .2s ease;
        }

            .password-toggle:hover {
                background: #f5f6f8;
            }

            .password-toggle .svg-icon svg {
                width: 20px;
                height: 20px;
            }


        /* =========================================================
                   OLVIDASTE CONTRASEÑA
                ========================================================= */

        .login-forgot {
            flex-shrink: 0;
            font-size: 13px;
            font-weight: 500;
            text-decoration: none;
            color: #ef0018 !important;
            transition: .2s ease;
        }

            .login-forgot:hover {
                color: #c80014 !important;
                text-decoration: underline;
            }


        /* =========================================================
                   BOTÓN
                ========================================================= */

        .login-submit {
            width: 100%;
            height: 54px;
            margin-top: 5px;
            border: none !important;
            outline: none;
            border-radius: 7px;
            background: #ef0018 !important;
            color: #ffffff !important;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 13px;
            font-family: 'Inter', sans-serif;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            box-shadow: 0 6px 16px rgba(239, 0, 24, .16);
            transition: transform .2s ease, background .2s ease, box-shadow .2s ease;
        }

            .login-submit:hover {
                background: #d80016 !important;
                transform: translateY(-1px);
                box-shadow: 0 9px 22px rgba(239, 0, 24, .24);
            }

            .login-submit:active {
                transform: translateY(0);
            }

            .login-submit .svg-icon {
                color: #ffffff;
            }

                .login-submit .svg-icon svg {
                    width: 19px;
                    height: 19px;
                }


        /* =========================================================
                   FOOTER CARD
                ========================================================= */

        .login-footer {
            width: 100%;
            min-width: 0;
            display: flex;
            align-items: center;
            gap: 14px;
            margin-top: 31px;
        }

        .login-footer-line {
            height: 1px;
            flex: 1;
            background: #d7dce4;
        }

        .login-footer-text {
            flex-shrink: 0;
            font-size: 10px;
            font-weight: 500;
            color: #7e8797;
            text-transform: uppercase;
            white-space: nowrap;
        }


        /* =========================================================
                   MENSAJE CORPORATIVO IZQUIERDO
                ========================================================= */

        .brand-message {
            position: absolute;
            left: 5.8%;
            top: 57%;
            transform: translateY(-50%);
            z-index: 4;
            color: #ffffff;
        }

        .brand-line {
            width: 72px;
            height: 4px;
            margin-bottom: 22px;
            border-radius: 3px;
            background: #ef0018;
            box-shadow: 0 0 12px rgba(239, 0, 24, .20);
        }

        .brand-title-small {
            font-size: 31px;
            line-height: 1.1;
            font-weight: 400;
            letter-spacing: 1px;
            color: #ffffff;
            text-shadow: 0 3px 12px rgba(0, 0, 0, .25);
        }

        .brand-title-main {
            margin-top: 4px;
            font-size: 35px;
            line-height: 1.05;
            font-weight: 700;
            letter-spacing: .3px;
            color: #ffffff;
            text-shadow: 0 3px 14px rgba(0, 0, 0, .30);
        }

        .brand-subtitle {
            margin-top: 23px;
            font-size: 16px;
            font-weight: 400;
            letter-spacing: 5px;
            color: rgba(255, 255, 255, .72);
            white-space: nowrap;
            text-shadow: 0 2px 8px rgba(0, 0, 0, .25);
        }

            .brand-subtitle span {
                margin: 0 7px;
                color: rgba(255, 255, 255, .55);
            }


        /* =========================================================
                   VALORES
                ========================================================= */

        .brand-values {
            position: absolute;
            top: 5.5%;
            right: 5.5%;
            z-index: 5;
            display: flex;
            flex-direction: column;
            gap: 7px;
            text-align: left;
            pointer-events: none;
        }

            .brand-values span {
                display: block;
                font-size: 15px;
                line-height: 1.1;
                font-weight: 400;
                letter-spacing: 3px;
                color: rgba(255, 255, 255, .48);
                text-transform: uppercase;
                text-shadow: 0 2px 8px rgba(0, 0, 0, .25);
            }


        /* =========================================================
                   MENSAJE INFERIOR
                ========================================================= */

        .brand-footer-message {
            position: fixed;
            left: 3.4%;
            bottom: 6.2%;
            z-index: 5;
            display: flex;
            align-items: center;
            gap: 17px;
            color: #ffffff;
        }

        .brand-footer-icon {
            width: 48px;
            height: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            color: rgba(255, 255, 255, .78);
        }

            .brand-footer-icon .svg-icon svg {
                width: 43px;
                height: 43px;
            }

        .brand-footer-content {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .brand-footer-title {
            font-size: 14px;
            line-height: 1.2;
            font-weight: 500;
            letter-spacing: 1.7px;
            text-transform: uppercase;
            color: rgba(255, 255, 255, .82);
            white-space: nowrap;
            text-shadow: 0 2px 8px rgba(0, 0, 0, .30);
        }

        .brand-footer-hashtag {
            font-size: 13px;
            line-height: 1.2;
            font-weight: 500;
            letter-spacing: .5px;
            color: #ef0018;
            white-space: nowrap;
            text-shadow: 0 2px 8px rgba(0, 0, 0, .35);
        }


        /* =========================================================
                   LAPTOP
                ========================================================= */

        @@media (max-width: 1400px) {

            .gurkas-login-page {
                padding-right: 5%;
            }

            .login-wrapper {
                max-width: 455px;
            }

            .gurkas-login-card {
                padding: 40px 36px 36px;
            }

            .login-title {
                font-size: 28px;
            }

            .brand-message {
                left: 4.5%;
                top: 58%;
            }

            .brand-title-small {
                font-size: 25px;
            }

            .brand-title-main {
                font-size: 30px;
            }

            .brand-subtitle {
                font-size: 13px;
                letter-spacing: 3px;
            }

            .brand-footer-message {
                left: 3%;
                bottom: 4%;
            }

            .brand-footer-title {
                font-size: 12px;
            }

            .brand-footer-hashtag {
                font-size: 11px;
            }

            .brand-footer-icon .svg-icon svg {
                width: 37px;
                height: 37px;
            }

            .brand-values {
                top: 4%;
                right: 4%;
            }

                .brand-values span {
                    font-size: 12px;
                    letter-spacing: 2.5px;
                }
        }


        /* =========================================================
                   TABLET
                ========================================================= */

        @@media (max-width: 1050px) {

            body {
                overflow-y: auto;
            }

            .gurkas-login-page {
                position: relative;
                width: 100%;
                min-width: 0;
                min-height: 100vh;
                padding: 30px;
                display: flex;
                align-items: center;
                justify-content: center;
                background-size: cover;
                background-position: 40% center;
                overflow: hidden;
            }

                .gurkas-login-page::before {
                    content: '';
                    position: absolute;
                    inset: 0;
                    background: rgba(4, 17, 32, .42);
                    z-index: 1;
                }

            .brand-message,
            .brand-values {
                display: none !important;
            }

            .login-wrapper {
                position: relative;
                z-index: 10;
                width: 100%;
                max-width: 480px;
                margin: 0 auto;
            }

            .brand-footer-message {
                display: none;
            }
        }


        /* =========================================================
                   MÓVIL
                ========================================================= */

        @@media (max-width: 576px) {

            html,
            body {
                width: 100%;
                min-width: 0;
                min-height: 100%;
                margin: 0;
                padding: 0;
                overflow-x: hidden;
            }

            body {
                overflow-y: auto;
            }

            .gurkas-login-page {
                position: relative;
                width: 100%;
                min-width: 0;
                min-height: 100vh;
                min-height: 100dvh;
                margin: 0;
                padding: 20px 16px 115px;
                display: flex;
                align-items: center;
                justify-content: center;
                background-position: 43% center;
                overflow: hidden;
            }

                .gurkas-login-page::before {
                    content: '';
                    position: absolute;
                    inset: 0;
                    background: rgba(3, 15, 28, .45);
                    z-index: 1;
                }

            .brand-message,
            .brand-values {
                display: none !important;
            }

            .login-wrapper {
                position: relative;
                z-index: 10;
                width: 100%;
                max-width: 390px;
                margin: 0 auto;
            }

            .gurkas-login-card {
                width: 100%;
                margin: 0;
                padding: 32px 22px 28px;
                border-radius: 15px;
                background: rgba(255, 255, 255, .98);
                box-shadow: 0 20px 50px rgba(0, 0, 0, .30);
            }

            .login-header {
                margin-bottom: 27px;
            }

            .login-title {
                font-size: 24px;
            }

            .login-subtitle {
                margin-top: 7px;
                font-size: 12px;
                line-height: 1.4;
            }

            .login-field {
                margin-bottom: 20px;
            }

            .login-label {
                font-size: 12px;
            }

            .gurkas-input {
                height: 49px;
                padding-left: 13px;
                padding-right: 8px;
                gap: 9px;
            }

                .gurkas-input input {
                    font-size: 12px;
                }

                    .gurkas-input input::placeholder {
                        font-size: 12px;
                    }

            .password-header {
                gap: 8px;
            }

            .login-forgot {
                font-size: 10px;
                white-space: nowrap;
            }

            .password-toggle {
                width: 32px;
                height: 32px;
            }

            .login-submit {
                height: 50px;
                margin-top: 3px;
                font-size: 13px;
            }

            .login-footer {
                gap: 7px;
                margin-top: 24px;
            }

            .login-footer-line {
                min-width: 15px;
            }

            .login-footer-text {
                flex-shrink: 1;
                font-size: 7px;
                white-space: nowrap;
                text-align: center;
            }

            .brand-footer-message {
                display: flex;
                position: absolute;
                left: 50%;
                bottom: -78px;
                transform: translateX(-50%);
                z-index: 3;
                width: max-content;
                max-width: calc(100vw - 32px);
                align-items: center;
                justify-content: center;
                gap: 12px;
            }

            .brand-footer-icon {
                width: 38px;
                height: 38px;
            }

                .brand-footer-icon .svg-icon svg {
                    width: 34px;
                    height: 34px;
                }

            .brand-footer-title {
                font-size: 11px;
                font-weight: 600;
                letter-spacing: 1.3px;
                color: rgba(255, 255, 255, .95);
            }

            .brand-footer-hashtag {
                font-size: 10px;
                font-weight: 600;
            }
        }


        /* =========================================================
                   CELULARES PEQUEÑOS
                ========================================================= */

        @@media (max-width: 380px) {

            .gurkas-login-page {
                padding: 16px 12px 105px;
            }

            .gurkas-login-card {
                padding: 28px 18px 25px;
            }

            .login-header {
                margin-bottom: 24px;
            }

            .login-title {
                font-size: 22px;
            }

            .login-subtitle {
                font-size: 11px;
            }

            .login-label {
                font-size: 11px;
            }

            .login-forgot {
                font-size: 9px;
            }

            .gurkas-input {
                height: 47px;
            }

                .gurkas-input input {
                    font-size: 11px;
                }

            .login-submit {
                height: 48px;
                font-size: 12px;
            }

            .login-footer-text {
                font-size: 6.5px;
            }

            .brand-footer-message {
                bottom: -72px;
                gap: 10px;
            }

            .brand-footer-title {
                font-size: 9.5px;
            }

            .brand-footer-hashtag {
                font-size: 9px;
            }
        }

    </style>

</head>

<body>

    <main class="gurkas-login-page">


        <!-- =========================================================
             TEXTO CORPORATIVO
        ========================================================== -->

        <div class="brand-message">

            <div class="brand-line"></div>

            <div class="brand-title-small">
                SISTEMA DE
            </div>

            <div class="brand-title-main">
                GESTIÓN EMPRESARIAL
            </div>

            <div class="brand-subtitle">
                INTEGRACIÓN
                <span>|</span>
                CONTROL
                <span>|</span>
                EFICIENCIA
            </div>

        </div>


        <!-- VALORES -->

        <div class="brand-values">
            <span>COMPROMISO</span>
            <span>EXCELENCIA</span>
            <span>CONFIANZA</span>
        </div>


        <!-- =========================================================
             LOGIN
        ========================================================== -->

        <div class="login-wrapper">

            <div class="gurkas-login-card">


                <!-- HEADER -->

                <div class="login-header">

                    <h1 class="login-title">
                        Acceso al sistema
                    </h1>

                    <p class="login-subtitle">
                        Ingresa tus credenciales para continuar
                    </p>

                </div>


                <!-- =================================================
                     FORMULARIO
                ================================================== -->

                <form asp-controller="Acceso"
                      asp-action="Index"
                      method="POST"
                      id="sign_in_form">

                    @Html.AntiForgeryToken()


                    <!-- =================================================
                         USUARIO
                    ================================================== -->

                    <div class="login-field">

                        <label class="login-label">
                            Usuario o correo electrónico
                        </label>

                        <div class="gurkas-input">


                            <!-- ICONO USUARIO - METRONIC DUOTUNE -->

                            <span class="svg-icon svg-icon-2">

                                <svg width="24"
                                     height="24"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     xmlns="http://www.w3.org/2000/svg">

                                    <path opacity="0.3"
                                          d="M22 12C22 17.5228 17.5228 22 12 22C6.47715 22 2 17.5228 2 12C2 6.47715 6.47715 2 12 2C17.5228 2 22 6.47715 22 12Z"
                                          fill="currentColor" />

                                    <path d="M12 6C10.3431 6 9 7.34315 9 9C9 10.6569 10.3431 12 12 12C13.6569 12 15 10.6569 15 9C15 7.34315 13.6569 6 12 6Z"
                                          fill="currentColor" />

                                    <path d="M12 14C8.68629 14 6 16.0147 6 18.5C7.67157 20.0586 9.77317 21 12 21C14.2268 21 16.3284 20.0586 18 18.5C18 16.0147 15.3137 14 12 14Z"
                                          fill="currentColor" />

                                </svg>

                            </span>


                            <input name="usuario"
                                   type="text"
                                   autocomplete="username"
                                   placeholder="Ingresa tu usuario o correo electrónico" />

                        </div>

                    </div>


                    <!-- =================================================
                         CONTRASEÑA
                    ================================================== -->

                    <div class="login-field">


                        <div class="password-header">

                            <label class="login-label">
                                Contraseña
                            </label>

                            <a href="#"
                               class="login-forgot">

                                ¿Olvidaste tu contraseña?

                            </a>

                        </div>


                        <div class="gurkas-input">


                            <!-- ICONO CANDADO - METRONIC DUOTUNE -->

                            <span class="svg-icon svg-icon-2">

                                <svg width="24"
                                     height="24"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     xmlns="http://www.w3.org/2000/svg">

                                    <path opacity="0.3"
                                          d="M6 10V8C6 4.68629 8.68629 2 12 2C15.3137 2 18 4.68629 18 8V10H16V8C16 5.79086 14.2091 4 12 4C9.79086 4 8 5.79086 8 8V10H6Z"
                                          fill="currentColor" />

                                    <path d="M5 10H19C20.1046 10 21 10.8954 21 12V20C21 21.1046 20.1046 22 19 22H5C3.89543 22 3 21.1046 3 20V12C3 10.8954 3.89543 10 5 10Z"
                                          fill="currentColor" />

                                    <path opacity="0.5"
                                          d="M12 14C11.4477 14 11 14.4477 11 15V17C11 17.5523 11.4477 18 12 18C12.5523 18 13 17.5523 13 17V15C13 14.4477 12.5523 14 12 14Z"
                                          fill="white" />

                                </svg>

                            </span>


                            <input id="passwordInput"
                                   name="user_password"
                                   type="password"
                                   autocomplete="current-password"
                                   placeholder="Ingresa tu contraseña" />


                            <!-- =================================================
                                 OJO
                            ================================================== -->

                            <button type="button"
                                    class="password-toggle"
                                    id="passwordToggle"
                                    aria-label="Mostrar contraseña">


                                <!-- OJO ABIERTO -->

                                <span id="eyeOpen"
                                      class="svg-icon svg-icon-2">

                                    <svg width="24"
                                         height="24"
                                         viewBox="0 0 24 24"
                                         fill="none"
                                         xmlns="http://www.w3.org/2000/svg">

                                        <path opacity="0.3"
                                              d="M2 12C2 12 5.5 6 12 6C18.5 6 22 12 22 12C22 12 18.5 18 12 18C5.5 18 2 12 2 12Z"
                                              fill="currentColor" />

                                        <path d="M12 9C10.3431 9 9 10.3431 9 12C9 13.6569 10.3431 15 12 15C13.6569 15 15 13.6569 15 12C15 10.3431 13.6569 9 12 9Z"
                                              fill="currentColor" />

                                    </svg>

                                </span>


                                <!-- OJO CERRADO -->

                                <span id="eyeClosed"
                                      class="svg-icon svg-icon-2"
                                      style="display:none;">

                                    <svg width="24"
                                         height="24"
                                         viewBox="0 0 24 24"
                                         fill="none"
                                         xmlns="http://www.w3.org/2000/svg">

                                        <path opacity="0.3"
                                              d="M4.2 4.2L19.8 19.8L18.4 21.2L15.9 18.7C14.7 19.2 13.4 19.5 12 19.5C5.5 19.5 2 12 2 12C2 12 3.2 9.5 5.6 7.4L2.8 4.6L4.2 4.2Z"
