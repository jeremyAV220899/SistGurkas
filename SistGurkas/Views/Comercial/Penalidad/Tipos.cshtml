@model List<SistGurkas.Models.Comercial.TipoPenalidad>
@{ViewData["Title"]="Tipos de Penalidades";}<style>.hero{background:linear-gradient(110deg,#f7fbff,#eaf5ff);border:1px solid #dbeafe;border-radius:14px;padding:22px}.kpi{border:1px solid #e5e7eb;border-radius:12px;padding:18px;background:#fff;box-shadow:0 4px 18px #0f172a0b}.kpi b{font-size:26px;color:#10224b}.panel{border:1px solid #e5e7eb;border-radius:12px;background:#fff;padding:16px}.pill{padding:5px 10px;border-radius:8px;background:#e8f2ff;color:#0866d8;font-weight:600}.table thead th{background:#f5f9ff;color:#183153;font-size:12px;white-space:nowrap}.table td{font-size:13px;vertical-align:middle}.nav-pills .nav-link.active{background:#0969ef}.muted{color:#8492ad}</style><div class="container-fluid py-4"><div class="hero mb-3"><div class="text-primary small">COMERCIAL › PENALIDADES › TIPOS</div><h2>Tipos de Penalidades</h2><div class="muted">Base maestra normalizada a partir de cláusulas contractuales.</div></div><div class="panel"><table class="table"><thead><tr><th>Código</th><th>Descripción</th><th>Categoría</th><th>Gravedad</th><th>Estado</th></tr></thead><tbody>@foreach(var x in Model){<tr><td><b>@x.Codigo</b></td><td>@x.Descripcion</td><td><span class="pill">@x.Categoria</span></td><td>@x.Gravedad</td><td>@(x.IdEstado==1?"Activo":"Inactivo")</td></tr>}@if(!Model.Any()){<tr><td colspan="5" class="text-center muted py-5">Se crearán automáticamente al publicar penalidades detectadas por IA.</td></tr>}</tbody></table></div></div>