@model List<SistGurkas.Models.Comercial.PenalidadClienteItem>
@{ViewData["Title"]="Penalidades por cliente";}<style>.hero{background:linear-gradient(110deg,#f7fbff,#eaf5ff);border:1px solid #dbeafe;border-radius:14px;padding:22px}.kpi{border:1px solid #e5e7eb;border-radius:12px;padding:18px;background:#fff;box-shadow:0 4px 18px #0f172a0b}.kpi b{font-size:26px;color:#10224b}.panel{border:1px solid #e5e7eb;border-radius:12px;background:#fff;padding:16px}.pill{padding:5px 10px;border-radius:8px;background:#e8f2ff;color:#0866d8;font-weight:600}.table thead th{background:#f5f9ff;color:#183153;font-size:12px;white-space:nowrap}.table td{font-size:13px;vertical-align:middle}.nav-pills .nav-link.active{background:#0969ef}.muted{color:#8492ad}</style><div class="container-fluid py-4"><div class="hero mb-3"><div class="text-primary small">COMERCIAL › PENALIDADES › POR CLIENTE</div><h2>Penalidades por cliente</h2><div class="muted">Configuración contractual aplicable a cada cliente y contrato.</div></div><div class="panel"><div class="table-responsive"><table class="table"><thead><tr><th>#</th><th>Cliente</th><th>Contrato</th><th>Tipo</th><th>Categoría</th><th>Forma de cálculo</th><th>Valor/Condición</th><th>Área responsable</th><th>Estado</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.IdPenalidadCliente</td><td><b>@x.Cliente</b></td><td>@x.Contrato</td><td>@x.Descripcion</td><td><span class="pill">@x.Categoria</span></td><td>@x.FormaCalculo</td><td>@x.Valor @x.UnidadCalculo</td><td>@x.AreaResponsable</td><td>@(x.IdEstado==1?"Activo":"Inactivo")</td></tr>}</tbody></table></div></div></div>