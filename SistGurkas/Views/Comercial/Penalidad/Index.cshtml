@model SistGurkas.Models.Comercial.PenalidadDashboardVm
@{
    ViewData["Title"] = "Penalidades"; decimal maxMes = Math.Max(1, Model.PorMes.Select(x => x.Valor).DefaultIfEmpty(0).Max()); decimal maxCli = Math.Max(1, Model.PorCliente.Select(x => x.Valor).DefaultIfEmpty(0).Max());
}
<style>
    .pen-page .card {
        border: 0;
        box-shadow: 0 2px 10px rgba(0,0,0,.05)
    }

    .pen-hero {
        background: linear-gradient(110deg,#204b86,#2f65aa);
        color: #fff;
        border-radius: 14px;
        padding: 22px
    }

    .pen-kpi {
        border-top: 3px solid #3485f5 !important
    }

    .kicon {
        width: 46px;
        height: 46px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 21px
    }

    .chartbox {
        min-height: 260px
    }

    .barrow {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 13px 0
    }

    .barlabel {
        width: 105px;
        font-size: 12px
    }

    .bartrack {
        height: 18px;
        background: #edf3fb;
        flex: 1
    }

    .barfill {
        height: 100%;
        background: #4d91f7
    }

    .badge-soft {
        padding: 5px 10px;
        border-radius: 7px;
        font-weight: 600
    }

    .table thead th {
        background: #f4f8fd;
        color: #17365f;
        font-size: 12px;
        white-space: nowrap
    }

    .table td {
        font-size: 12px;
        vertical-align: middle
    }

    .filter-card label {
        font-size: 12px;
        color: #334b72
    }

    .money {
        font-size: 23px;
        font-weight: 700;
        color: #10224b
    }
</style>
<div class="container-fluid py-4 pen-page">
    <div class="pen-hero d-flex justify-content-between align-items-center mb-3"><div><div class="small opacity-75">COMERCIAL · PENALIDADES</div><h2 class="mb-1 text-white">Penalidades Contractuales</h2><div class="opacity-75">Gestiona, analiza y da seguimiento a las penalidades reales derivadas de TDR y contratos.</div></div><div class="d-flex gap-2"><a asp-action="PorCliente" class="btn btn-light">Configuración contractual</a><button type="button" class="btn btn-primary" id="btnNuevaPenalidad">+ Nueva Penalidad</button></div></div>
    <div class="row g-3 mb-3">
        @foreach (var k in new[] { ("Total penalidades", Model.MontoTotal.ToString("N2"), "S/ ", "bi-exclamation-triangle", "#fee2e2", "#ef4444"), ("Penalidades registradas", (Model.Registradas + Model.EnAnalisis + Model.PendientesPago + Model.Pagadas).ToString(), "", "bi-box", "#fff0df", "#ff7a00"), ("Penalidades anuladas", Model.Anuladas.ToString(), "", "bi-shield-check", "#dcfce7", "#16a34a"), ("En análisis", Model.EnAnalisis.ToString(), "", "bi-hourglass-split", "#f3e8ff", "#8b5cf6"), ("Pendientes de pago", Model.PendientesPago.ToString(), "", "bi-receipt", "#fff7d6", "#eab308"), ("Pagadas", Model.Pagadas.ToString(), "", "bi-cart-check", "#e5f1ff", "#2583e9") })
        {
            <div class="col-xl-2 col-md-4"><div class="card pen-kpi h-100"><div class="card-body d-flex gap-3 align-items-center"><div class="kicon" style="background:@k.Item5;color:@k.Item6"><i class="bi @k.Item4"></i></div><div><div class="small">@k.Item1</div><div class="money">@k.Item3@k.Item2</div></div></div></div></div>
        }
    </div>
    <div class="row g-3 mb-3"><div class="col-lg-4"><div class="card chartbox"><div class="card-body"><h5>Penalidades por mes (Monto)</h5>@foreach(var x in Model.PorMes){
        <div class="barrow"><span class="barlabel">@x.Etiqueta</span><div class="bartrack"><div class="barfill" style="width:@((x.Valor / maxMes * 100).ToString("0", System.Globalization.CultureInfo.InvariantCulture))%"></div></div><b class="small">S/ @x.Valor.ToString("N0")</b></div>
    }
    @if (!Model.PorMes.Any())
    {
        <div class="text-muted py-5 text-center">Sin penalidades registradas todavía.</div>
    }
</div></div></div><div class="col-lg-4"><div class="card chartbox"><div class="card-body"><h5>Penalidades por cliente (Monto)</h5>@foreach(var x in Model.PorCliente.Take(6)){
<div class="barrow"><span class="barlabel">@x.Etiqueta</span><div class="bartrack"><div class="barfill" style="width:@((x.Valor / maxCli * 100).ToString("0", System.Globalization.CultureInfo.InvariantCulture))%"></div></div><b class="small">S/ @x.Valor.ToString("N0")</b></div>
}
</div></div></div><div class="col-lg-4"><div class="card chartbox"><div class="card-body"><h5>Penalidades por tipo</h5>@foreach(var x in Model.PorCategoria){
<div class="d-flex justify-content-between border-bottom py-3"><span>@x.Etiqueta</span><b>@x.Cantidad</b></div>
}
</div></div></div></div>
<div class="card filter-card mb-3"><div class="card-body"><div class="row g-3"><div class="col-md"><label>Año</label><select class="form-select"><option>2026</option></select></div><div class="col-md"><label>Cliente</label><select class="form-select"><option>Todos</option></select></div><div class="col-md"><label>Contrato</label><select class="form-select"><option>Todos</option></select></div><div class="col-md"><label>Sede</label><select class="form-select"><option>Todas</option></select></div><div class="col-md"><label>Tipo de penalidad</label><select class="form-select"><option>Todos</option></select></div><div class="col-md"><label>Estado</label><select class="form-select"><option>Todos</option></select></div><div class="col-md-auto d-flex align-items-end"><button class="btn btn-primary px-5">Buscar</button></div></div></div></div>
<div class="card"><div class="card-body"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>#</th><th>Fecha</th><th>N.º Carta / Documento</th><th>Cliente</th><th>Contrato</th><th>Sede</th><th>Tipo de penalidad</th><th>Descripción</th><th>Monto (S/)</th><th>Estado</th><th>Responsable</th><th>Acciones</th></tr></thead><tbody>@foreach(var x in Model.Penalidades){var cls=x.Estado=="PAGADA"?"bg-success-subtle text-success":x.Estado=="ANULADA"?"bg-secondary-subtle":x.Estado=="EN ANALISIS"?"bg-primary-subtle text-primary":"bg-warning-subtle text-warning";
    <tr><td>@x.IdPenalidad</td><td>@x.Fecha.ToString("dd/MM/yyyy")</td><td>@x.NumeroDocumento</td><td><b>@x.Cliente</b></td><td>@x.Contrato</td><td>@x.Sede</td><td>@x.Categoria</td><td>@x.Descripcion</td><td>@x.MontoTotal.ToString("N2")</td><td><span class="badge-soft @cls">@x.Estado</span></td><td>@x.Responsable</td><td><button class="btn btn-sm btn-light-primary"><i class="bi bi-eye"></i></button></td></tr>
}
@if (!Model.Penalidades.Any())
{
    <tr><td colspan="12" class="text-center text-muted py-5">Todavía no existen penalidades reales. Las cláusulas detectadas por IA permanecen disponibles en “Configuración contractual”.</td></tr>
}
</tbody></table></div></div></div>
</div>
@if (TempData["Ok"] != null)
{
    <script>document.addEventListener('DOMContentLoaded',()=>toastr.success('@TempData["Ok"]'));</script>
}

<div class="modal fade" id="modalNuevaPenalidad" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered" style="max-width:96vw;height:96vh;margin-top:2vh;margin-bottom:2vh">
        <div class="modal-content" id="contenidoNuevaPenalidad" style="max-height:96vh;overflow:hidden"></div>
    </div>
</div>
<script>
    (() => {
     const btn=document.getElementById('btnNuevaPenalidad');
     const el=document.getElementById('modalNuevaPenalidad');
     const box=document.getElementById('contenidoNuevaPenalidad');
     if(!btn||!el||!box) return;
     btn.addEventListener('click', async () => {
       box.innerHTML='<div class="p-5 text-center"><div class="spinner-border text-primary"></div><div class="mt-3 text-muted">Cargando formulario...</div></div>';
       bootstrap.Modal.getOrCreateInstance(el).show();
       try {
         const res=await fetch('@Url.Action("Nueva", "Penalidad")',{headers:{'X-Requested-With':'XMLHttpRequest'}});
         if(!res.ok) throw new Error('HTTP '+res.status);
         box.innerHTML=await res.text();
         if(window.initNuevaPenalidad) window.initNuevaPenalidad();
       } catch(e) {
         box.innerHTML='<div class="modal-header"><h5 class="modal-title">Nueva Penalidad</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="alert alert-danger mb-0">No se pudo cargar el formulario. '+e.message+'</div></div>';
       }
     });
    })();
</script>
