                             window.prepararReqDesdeIa=p=>{if(!det){toastr.error('Abre primero el detalle del cliente.');return;}g('formReq').reset();g('rqId').value=0;g('rqUnidad').value=actual;fillSelect(g('rqContrato'),det.contratos,'idContrato','numeroContrato');fillSelect(g('rqSede'),det.sedes,'idSede','nombreSede');g('rqPuesto').value=p.puestoPerfil||'';g('rqCant').value=p.cantidad||1;let m=(p.modalidad||'').toLowerCase();g('rqMod').value=m.includes('armad')?'Armado':'Simple';reqSetHorario(p.horario||'');g('rqObs').value=`Detectado por IA desde TDR. Fuente: ${p.fuente||'sin referencia'}. Validar sede, modalidad, días y fechas antes de guardar.`;mrq.show();toastr.info('Selecciona el contrato y la sede correctos antes de guardar.');};
                             window.publicarDatosTdr=async tipo=>{if(!iaDocId)return;let destino=tipo==='REQUERIMIENTOS'?'TDR / Requerimientos':'Penalidades por cliente';let q=await Swal.fire({title:`¿Publicar para ${destino}?`,html:'Se copiarán los datos <b>ya almacenados</b> del análisis a la capa contractual del ERP.<br>No se realizará ninguna llamada a OpenAI.',icon:'question',showCancelButton:true,confirmButtonText:'Sí, publicar',cancelButtonText:'Cancelar'});if(!q.isConfirmed)return;try{let body=new URLSearchParams({idDocumento:iaDocId,tipo,__RequestVerificationToken:token()}),r=await fetch('@Url.Action("PublicarDatosContractualesTdr","Cliente")',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body}),j=await r.json();j.ok?toastr.success(j.mensaje):toastr.error(j.mensaje);}catch(e){toastr.error(e.message||'No se pudo publicar.')}};
                             async function cambiarEstado(url,campo,id,e){let ne=e===1?2:1,q=await Swal.fire({title:'¿Confirmar acción?',icon:'question',showCancelButton:true});if(!q.isConfirmed)return;let o={idEstado:ne,__RequestVerificationToken:token()};o[campo]=id;let r=await fetch(url,{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:new URLSearchParams(o)}),j=await r.json();j.ok?(toastr.success(j.mensaje),cargar(actual)):toastr.error(j.mensaje)}
                             document.querySelectorAll('.btnEstado').forEach(b=>b.onclick=async()=>{let ne=+b.dataset.estado===1?2:1,q=await Swal.fire({title:'¿Confirmar acción?',text:`¿Deseas ${ne===1?'activar':'dar de baja'} a ${b.dataset.nombre}?`,icon:'question',showCancelButton:true});if(!q.isConfirmed)return;let body=new URLSearchParams({idUnidad:b.dataset.id,idEstado:ne,__RequestVerificationToken:token()}),r=await fetch('@Url.Action("CambiarEstado","Cliente")',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body}),j=await r.json();if(j.ok){toastr.success(j.mensaje);setTimeout(()=>location.reload(),600)}else toastr.error(j.mensaje)});
            });</script>
            @if (TempData["Success"] is string s)
            {
                <script>toastr.success(@Html.Raw(JsonSerializer.Serialize(s)));</script>
            }
            @if (TempData["Error"] is string e)
            {
                <script>toastr.error(@Html.Raw(JsonSerializer.Serialize(e)));</script>
            }

        }
